# Contact form: POST target for a free form service (Formspree, Getform, Web3Forms...).
# Leave empty and the form falls back to opening the visitor's email app (mailto:).
VITE_FORM_ENDPOINT=

# Optional Umami analytics. Both must be set or the script is not loaded.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
